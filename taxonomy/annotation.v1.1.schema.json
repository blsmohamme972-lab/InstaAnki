{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstaAnki Question Tag Annotation v1.1",
  "description": "Controlled English vocabulary annotation for one source question. The optional concept_ids facet describes tested anatomical or physiological principles without inferring a diagnosis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_id",
    "question_version",
    "taxonomy_version",
    "annotation_revision",
    "status",
    "tested_objective",
    "primary_specialty_id",
    "secondary_specialty_ids",
    "primary_domain_id",
    "secondary_domain_ids",
    "condition_ids",
    "procedure_ids",
    "anatomy_ids",
    "focus_id",
    "phase_id",
    "population_id",
    "evidence",
    "review_reason",
    "missing_concept_proposals"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "question_version": {
      "type": "integer",
      "minimum": 1
    },
    "taxonomy_version": {
      "const": "1.1.0"
    },
    "annotation_revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "validated",
        "needs_review"
      ]
    },
    "tested_objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "primary_specialty_id": {
      "enum": [
        "specialty.cardiac",
        "specialty.thoracic",
        "specialty.vascular",
        null
      ]
    },
    "secondary_specialty_ids": {
      "type": "array",
      "items": {
        "enum": [
          "specialty.cardiac",
          "specialty.thoracic",
          "specialty.vascular"
        ]
      },
      "uniqueItems": true,
      "maxItems": 2
    },
    "primary_domain_id": {
      "enum": [
        "domain.coronary",
        "domain.valvular",
        "domain.congenital",
        "domain.rhythm",
        "domain.heart_failure",
        "domain.heart_transplantation",
        "domain.pericardial",
        "domain.cardiac_tumors",
        "domain.perfusion",
        "domain.lung",
        "domain.airway",
        "domain.pleura",
        "domain.mediastinum",
        "domain.esophagus",
        "domain.chest_wall",
        "domain.diaphragm",
        "domain.lung_transplantation",
        "domain.peripheral_arterial",
        "domain.extracranial_cerebrovascular",
        "domain.visceral_renal",
        "domain.venous",
        "domain.lymphatic",
        "domain.dialysis_access",
        "domain.graft_complications",
        "domain.aortic",
        "domain.trauma",
        "domain.perioperative",
        "domain.vascular_compression",
        "domain.vascular_physiology",
        null
      ]
    },
    "secondary_domain_ids": {
      "type": "array",
      "items": {
        "enum": [
          "domain.coronary",
          "domain.valvular",
          "domain.congenital",
          "domain.rhythm",
          "domain.heart_failure",
          "domain.heart_transplantation",
