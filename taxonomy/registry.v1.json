{
  "schema_version": 1,
  "taxonomy_id": "instaanki-surgical-taxonomy",
  "version": "1.0.0",
  "language": "en",
  "created_on": "2026-11-07",
  "purpose": "A controlled English vocabulary for indexing surgical MCQs and derived lessons across books. This is an application taxonomy, not a clinical guideline or a complete official examination syllabus.",
  "coverage": "Initial vocabulary. Missing concepts are proposed through a versioned registry update; do not invent ad hoc production tags.",
  "roots": [
    "specialty.cardiac",
    "specialty.thoracic",
    "specialty.vascular"
  ],
  "facets": {
    "specialty": {
      "assignment": "Exactly one primary specialty; zero or more evidence-supported secondary specialties."
    },
    "domain": {
      "assignment": "One primary domain and optional secondary domains when the question explicitly tests an interaction."
    },
    "condition": {
      "assignment": "Zero or more specific conditions actually tested. Prefer the most specific supported descendant."
    },
    "procedure": {
      "assignment": "Zero or more procedures material to the tested objective, not every procedure mentioned."
    },
    "focus": {
      "assignment": "Exactly one primary learning focus."
    },
    "anatomy": {
      "assignment": "Optional, only when anatomical specificity aids retrieval and is supported."
    },
    "phase": {
      "assignment": "Optional explicit perioperative phase."
    },
    "population": {
      "assignment": "Optional explicit population; congenital does not imply pediatric."
    }
  },
  "tagging_rules": [
    "Read the stem, keyed answer and available explanation together; unresolved extraction or answer conflicts require review.",
    "Use only active canonical IDs from this registry. Aliases are search terms, not separate tags.",
    "Tag the tested learning objective; do not tag a condition solely because it is a distractor.",
    "Use one primary specialty. Add a secondary specialty only for actual overlap, not anatomical word matching.",
    "Thoracic aortic disease does not automatically belong to the Thoracic Surgery specialty.",
    "Use the shared Aortic Disease domain and shared condition IDs across Cardiac Surgery and Vascular Surgery.",
    "Never infer a population, severity, disease subtype or procedure that the source does not support.",
    "Record concise evidence for each selected ID. Low-confidence, out-of-scope or missing-concept cases remain needs_review.",
    "Prefer a small, sufficient set of tags; the interface derives parent categories without storing them as extra condition tags.",
    "Questions and their lessons reference the same clinical annotation. Book identity and source page are provenance, not clinical tags.",
    "Changing tags never changes question or lesson IDs and never resets FSRS learning history.",
    "Smart suggestions retrieve related concepts and due lessons; tags do not infer successful recall or overwrite scheduling results.",
    "Specialty eligibility guides routing; it does not auto-assign every eligible specialty. Ambiguous cross-specialty assignments require a documented review.",
    "Identical tags do not prove that two questions are duplicates; deduplication is a separate content review.",
    "Due, difficult, forgotten, production status and book names are not clinical tags; keep learner state, production state and provenance separate.",
    "Respect negation, EXCEPT questions and the actual question task; the keyed option alone does not define the entire tested concept."
  ],
  "version_policy": {
    "stable_ids": "Never reuse an ID for another concept. Labels and aliases may change without changing the concept ID.",
    "additions": "Add needed concepts in a documented minor version after checking synonyms, scope and parent relationships.",
    "corrections": "Use a patch version for nonsemantic corrections.",
    "merges": "Deprecate duplicate IDs with explicit replacement mappings; preserve aliases and old content references.",
    "semantic_changes": "Create a new ID for a changed meaning, record migration, and retain prior registry versions.",
    "question_snapshots": "Each annotation records taxonomy_version, question_id, question_version and annotation_revision."
  },
  "sources": [
    {
      "id": "abts-blueprint",
      "title": "ABTS Written Exam Blueprint",
      "url": "https://www.abts.org/ABTS/CertificationWebPages/Exam_Sequence/Written_Exam_Blueprint.aspx",
      "accessed_on": "2026-11-07",
      "use": "Broad cardiac and general thoracic subject coverage; does not endorse this application taxonomy."
    },
    {
      "id": "abs-definition",
      "title": "ABS Vascular Surgery Overview",
      "url": "https://www.absurgery.org/get-certified/vascular-surgery/",
      "accessed_on": "2026-11-07",
      "use": "Scope of vascular surgery, including arterial, venous and lymphatic disease."
    },
    {
      "id": "abs-epas",
      "title": "ABS Vascular Surgery EPAs",
      "url": "https://www.absurgery.org/get-certified/epas/vascular-surgery/",
      "accessed_on": "2026-11-07",
      "use": "Examples of vascular subject areas, including dialysis access and aortic disease."
    }
  ],
