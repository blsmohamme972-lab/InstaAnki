      "startSample": 0,
      "endSample": 247056,
      "voiceStartSample": 4320,
      "voiceEndSample": 241536,
      "text": "At the rear door of the cardiac gallery, picture a curved circumflex key. Keep that same doorway as your memory location whenever coronary dominance returns.",
      "spokenText": "At the rear door of the cardiac gallery, picture a curved circumflex key. Keep that same doorway as your memory location whenever coronary dominance returns."
    },
    {
      "id": "scene-02",
      "start": 10.294,
      "end": 20.122,
      "duration": 9.828,
      "voiceStart": 10.294,
      "voiceEnd": 19.892,
      "startSample": 247056,
      "endSample": 482928,
      "voiceStartSample": 247056,
      "voiceEndSample": 477408,
      "text": "Coronary dominance follows the artery that gives rise to the posterior descending artery. On the angiogram, trace that vessel back to its parent artery.",
      "spokenText": "Coronary dominance follows the artery that gives rise to the posterior descending artery. On the angiogram, trace that vessel back to its parent artery."
    },
    {
      "id": "scene-03",
      "start": 20.122,
      "end": 31.063333333333333,
      "duration": 10.941333333333333,
      "voiceStart": 20.122,
      "voiceEnd": 30.833333333333332,
      "startSample": 482928,
      "endSample": 745520,
      "voiceStartSample": 482928,
      "voiceEndSample": 740000,
      "text": "In a left-dominant circulation, the posterior descending artery comes from the circumflex. Its septal branches supply the posterior part of the interventricular septum.",
      "spokenText": "In a left-dominant circulation, the posterior descending artery comes from the circumflex. Its septal branches supply the posterior part of the interventricular septum."
    },
    {
      "id": "scene-04",
      "start": 31.063333333333333,
      "end": 41.08866666666667,
      "duration": 10.025333333333334,
      "voiceStart": 31.063333333333333,
      "voiceEnd": 40.858666666666664,
      "startSample": 745520,
      "endSample": 986128,
      "voiceStartSample": 745520,
      "voiceEndSample": 980608,
      "text": "The circumflex also supplies the lateral left ventricular wall through its branches. A clot at its origin can therefore threaten both territories downstream.",
      "spokenText": "The circumflex also supplies the lateral left ventricular wall through its branches. A clot at its origin can therefore threaten both territories downstream."
    },
    {
      "id": "scene-05",
      "start": 41.08866666666667,
      "end": 51.056,
      "duration": 9.967333333333332,
      "voiceStart": 41.08866666666667,
      "voiceEnd": 50.826,
      "startSample": 986128,
      "endSample": 1225344,
      "voiceStartSample": 986128,
      "voiceEndSample": 1219824,
      "text": "For the book's example, combine the lateral left ventricular wall with the posterior septum. Identifying only one of those regions would leave out part of the pattern.",
      "spokenText": "For the book's example, combine the lateral left ventricular wall with the posterior septum. Identifying only one of those regions would leave out part of the pattern."
    },
    {
      "id": "scene-06",
      "start": 51.056,
      "end": 62.166625,
      "duration": 11.110625,
      "voiceStart": 51.056,
      "voiceEnd": 61.816625,
      "startSample": 1225344,
      "endSample": 1491999,
      "voiceStartSample": 1225344,
      "voiceEndSample": 1483599,
      "text": "Return to the rear door: the circumflex key opens the lateral room and the back septal room. The recall cue is simple: left dominance, circumflex supplies the back.",
      "spokenText": "Return to the rear door: the circumflex key opens the lateral room and the back septal room. The recall cue is simple: left dominance, circumflex supplies the back."
    }
