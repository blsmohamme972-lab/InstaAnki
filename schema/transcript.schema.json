{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blsmohamme972-lab/InstaAnki/schema/transcript.schema.json",
  "title": "InstaAnki word-level transcript (transcript.json)",
  "type": "object",
  "required": ["words"],
  "properties": {
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["w", "s", "e"],
        "properties": {
          "w": { "type": "string", "minLength": 1 },
          "s": { "type": "number", "minimum": 0 },
          "e": { "type": "number", "minimum": 0 },
          "key": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["s", "e"],
        "properties": {
          "s": { "type": "number", "minimum": 0 },
          "e": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
