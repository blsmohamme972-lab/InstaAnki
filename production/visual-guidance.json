      "scenes": [
        {
          "id": "scene-01",
          "phrases": [
            {
              "id": "s01-p01",
              "text": "At the coat hook in the thoracic gallery,",
              "targetId": "coat-hook"
            },
            {
              "id": "s01-p02",
              "text": "imagine an extra lung parcel wearing its own coat.",
              "targetId": "extra-coat"
            },
            {
              "id": "s01-p03",
              "text": "Keep this same hook as the permanent location for extralobar sequestration.",
              "targetId": "coat-hook"
            }
          ]
        },
        {
          "id": "scene-02",
          "phrases": [
            {
              "id": "s02-p01",
              "text": "Pulmonary sequestration is abnormal lung tissue",
              "targetId": "lung-parcel"
            },
            {
              "id": "s02-p02",
              "text": "without the usual connection to the tracheobronchial tree.",
              "targetId": null
            },
            {
              "id": "s02-p03",
              "text": "It receives arterial blood from the systemic circulation, commonly through an aortic branch.",
              "targetId": "systemic-pipe"
            }
          ]
        },
        {
          "id": "scene-03",
          "phrases": [
            {
              "id": "s03-p01",
              "text": "Extralobar means the sequestered tissue has a separate visceral pleural covering.",
              "targetId": "clinical-pleura"
            },
            {
              "id": "s03-p02",
              "text": "In the operative photograph, focus on the distinct pleural envelope around the lesion.",
              "targetId": "clinical-pleura"
            }
          ]
        },
        {
          "id": "scene-04",
          "phrases": [
            {
              "id": "s04-p01",
              "text": "An intralobar sequestration instead lies within the surrounding lung",
              "targetId": null
            },
            {
              "id": "s04-p02",
              "text": "and shares its pleural covering.",
              "targetId": "shared-dome"
            },
            {
              "id": "s04-p03",
              "text": "The difference tested here is the relationship to visceral pleura.",
              "targetId": "extra-coat"
            }
          ]
        },
        {
          "id": "scene-05",
          "phrases": [
            {
              "id": "s05-p01",
              "text": "Use the relationship to pleura to identify the extralobar form,",
              "targetId": "separate-dome"
            },
            {
              "id": "s05-p02",
              "text": "and keep the feeding vessel as a separate anatomical feature.",
              "targetId": "systemic-pipe"
            },
            {
              "id": "s05-p03",
              "text": "This distinction makes the question much easier.",
              "targetId": null
            }
          ]
        },
        {
          "id": "scene-06",
          "phrases": [
            {
              "id": "s06-p01",
              "text": "Return to the coat hook and say:",
              "targetId": "coat-hook"
            },
            {
              "id": "s06-p02",
              "text": "extra means an extra coat.",
              "targetId": "extra-coat"
            },
            {
              "id": "s06-p03",
              "text": "In this lesson, that coat represents its own visceral pleura.",
              "targetId": "extra-coat"
            },
            {
              "id": "s06-p04",
              "text": "Retrieve the feature before choosing an answer.",
              "targetId": null
            }
          ]
        }
      ],
      "outroTargetId": "clinical-pleura",
      "annotationNotes": [
        "The clinical point is on the pleural-covered lesion in panel A immediately beyond the published white arrow tip. Its ellipse stays inside panel A; panels B, C, and D are not targets.",
        "No intralobar lesion, airway disconnection, or surgical measurement is fabricated in the mnemonic. Those clauses have no pointer.",
        "The coat target points to the visible coat collar, not to the pink lung parcel inside it."
      ]
    },
