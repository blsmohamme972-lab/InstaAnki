      },
      "uniqueItems": true,
      "maxItems": 3
    },
    "anatomy_ids": {
      "type": "array",
      "items": {
        "enum": [
          "anatomy.aortic_valve",
          "anatomy.mitral_valve",
          "anatomy.coronary_arteries",
          "anatomy.aortic_root",
          "anatomy.ascending_aorta",
          "anatomy.aortic_arch",
          "anatomy.descending_thoracic_aorta",
          "anatomy.abdominal_aorta",
          "anatomy.lung",
          "anatomy.pleura",
          "anatomy.esophagus",
          "anatomy.carotid_artery",
          "anatomy.lower_limb_arteries",
          "anatomy.deep_veins"
        ]
      },
      "uniqueItems": true,
      "maxItems": 3
    },
    "focus_id": {
      "enum": [
        "focus.anatomy",
        "focus.physiology",
        "focus.pathophysiology",
        "focus.diagnosis",
        "focus.investigation_selection",
        "focus.investigation_interpretation",
        "focus.classification_staging",
        "focus.indications",
        "focus.contraindications",
        "focus.treatment_selection",
        "focus.operative_technique",
        "focus.complications",
        "focus.perioperative_management",
        "focus.outcomes",
        "focus.surveillance",
        null
      ]
    },
    "phase_id": {
      "enum": [
        "phase.preoperative",
        "phase.intraoperative",
        "phase.postoperative",
        null
      ]
    },
    "population_id": {
      "enum": [
        "population.adult",
        "population.pediatric",
        "population.neonatal",
        null
      ]
    },
