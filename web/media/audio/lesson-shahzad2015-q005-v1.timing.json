      "voiceStartSample": 4320,
      "voiceEndSample": 250032,
      "text": "At the coat hook in the thoracic gallery, imagine an extra lung parcel wearing its own coat. Keep this same hook as the permanent location for extralobar sequestration.",
      "spokenText": "At the coat hook in the thoracic gallery, imagine an extra lung parcel wearing its own coat. Keep this same hook as the permanent location for extralobar sequestration."
    },
    {
      "id": "scene-02",
      "start": 10.648,
      "end": 23.354666666666667,
      "duration": 12.706666666666667,
      "voiceStart": 10.648,
      "voiceEnd": 23.124666666666666,
      "startSample": 255552,
      "endSample": 560512,
      "voiceStartSample": 255552,
      "voiceEndSample": 554992,
      "text": "Pulmonary sequestration is abnormal lung tissue without the usual connection to the tracheobronchial tree. It receives arterial blood from the systemic circulation, commonly through an aortic branch.",
      "spokenText": "Pulmonary sequestration is abnormal lung tissue without the usual connection to the tracheobronchial tree. It receives arterial blood from the systemic circulation, commonly through an aortic branch."
    },
    {
      "id": "scene-03",
      "start": 23.354666666666667,
      "end": 33.913291666666666,
      "duration": 10.558625,
      "voiceStart": 23.354666666666667,
      "voiceEnd": 33.68329166666667,
      "startSample": 560512,
      "endSample": 813919,
      "voiceStartSample": 560512,
      "voiceEndSample": 808399,
      "text": "Extralobar means the sequestered tissue has a separate visceral pleural covering. In the operative photograph, focus on the distinct pleural envelope around the lesion.",
      "spokenText": "Extralobar means the sequestered tissue has a separate visceral pleural covering. In the operative photograph, focus on the distinct pleural envelope around the lesion."
    },
    {
      "id": "scene-04",
      "start": 33.913291666666666,
      "end": 43.97591666666667,
      "duration": 10.062625,
      "voiceStart": 33.913291666666666,
      "voiceEnd": 43.745916666666666,
      "startSample": 813919,
      "endSample": 1055422,
      "voiceStartSample": 813919,
      "voiceEndSample": 1049902,
      "text": "An intralobar sequestration instead lies within the surrounding lung and shares its pleural covering. The difference tested here is the relationship to visceral pleura.",
      "spokenText": "An intralobar sequestration instead lies within the surrounding lung and shares its pleural covering. The difference tested here is the relationship to visceral pleura."
    },
    {
      "id": "scene-05",
      "start": 43.97591666666667,
      "end": 55.081208333333336,
      "duration": 11.105291666666666,
      "voiceStart": 43.97591666666667,
      "voiceEnd": 54.85120833333333,
      "startSample": 1055422,
      "endSample": 1321949,
      "voiceStartSample": 1055422,
      "voiceEndSample": 1316429,
      "text": "Use the relationship to pleura to identify the extralobar form, and keep the feeding vessel as a separate anatomical feature. This distinction makes the question much easier.",
      "spokenText": "Use the relationship to pleura to identify the extralobar form, and keep the feeding vessel as a separate anatomical feature. This distinction makes the question much easier."
    },
    {
      "id": "scene-06",
      "start": 55.081208333333336,
      "end": 65.54508333333334,
      "duration": 10.463875,
      "voiceStart": 55.081208333333336,
      "voiceEnd": 65.19508333333333,
      "startSample": 1321949,
      "endSample": 1573082,
      "voiceStartSample": 1321949,
      "voiceEndSample": 1564682,
      "text": "Return to the coat hook and say: extra means an extra coat. In this lesson, that coat represents its own visceral pleura. Retrieve the feature before choosing an answer.",
      "spokenText": "Return to the coat hook and say: extra means an extra coat. In this lesson, that coat represents its own visceral pleura. Retrieve the feature before choosing an answer."
    }
