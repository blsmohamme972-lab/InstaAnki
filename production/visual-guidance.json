      "scenes": [
        {
          "id": "scene-01",
          "phrases": [
            {
              "id": "s01-p01",
              "text": "At the double doors of the vascular gallery, imagine four number locks above the frame.",
              "targetId": "four-locks"
            },
            {
              "id": "s01-p02",
              "text": "Widening the doorway changes resistance",
              "targetId": "wide-opening"
            },
            {
              "id": "s01-p03",
              "text": "through a fourth-power relationship.",
              "targetId": "four-locks"
            }
          ]
        },
        {
          "id": "scene-02",
          "phrases": [
            {
              "id": "s02-p01",
              "text": "For steady laminar flow in the ideal tube model,",
              "targetId": null
            },
            {
              "id": "s02-p02",
              "text": "resistance is proportional to viscosity and length,",
              "targetId": null
            },
            {
              "id": "s02-p03",
              "text": "and inversely proportional to the fourth power of radius.",
              "targetId": "four-locks"
            }
          ]
        },
        {
          "id": "scene-03",
          "phrases": [
            {
              "id": "s03-p01",
              "text": "If diameter doubles, radius doubles too.",
              "targetId": "wide-opening"
            },
            {
              "id": "s03-p02",
              "text": "Raise that factor of two to the fourth power:",
              "targetId": "four-locks"
            },
            {
              "id": "s03-p03",
              "text": "two times two times two times two equals sixteen.",
              "targetId": null
            }
          ]
        },
        {
          "id": "scene-04",
          "phrases": [
            {
              "id": "s04-p01",
              "text": "Resistance therefore becomes one sixteenth of its original value",
              "targetId": "relieved-guard"
            },
            {
              "id": "s04-p02",
              "text": "when length and viscosity stay unchanged.",
              "targetId": null
            },
            {
              "id": "s04-p03",
              "text": "Starting from sixteen resistance units, the new value is one unit.",
              "targetId": null
            }
          ]
        },
        {
          "id": "scene-05",
          "phrases": [
            {
              "id": "s05-p01",
              "text": "This is an idealized laminar-flow relationship.",
              "targetId": null
            },
            {
              "id": "s05-p02",
              "text": "In real circulation, pulsation, branching, and vessel compliance affect how pressure and flow behave.",
              "targetId": null
            },
            {
              "id": "s05-p03",
              "text": "Keep the model assumptions in mind.",
              "targetId": null
            }
          ]
        },
        {
          "id": "scene-06",
          "phrases": [
            {
              "id": "s06-p01",
              "text": "Return to the double doors and the four locks.",
              "targetId": "four-locks"
            },
            {
              "id": "s06-p02",
              "text": "Remember: double diameter,",
              "targetId": "wide-opening"
            },
            {
              "id": "s06-p03",
              "text": "divide resistance by sixteen.",
              "targetId": "relieved-guard"
            },
            {
              "id": "s06-p04",
              "text": "The answer to this example is one peripheral resistance unit.",
              "targetId": null
            }
          ]
        }
      ],
      "outroTargetId": "arterial-lumen",
      "annotationNotes": [
        "The four-lock arrow tip is on the shield-shaped third lock; the separately centered ellipse covers all four. A midpoint arrow would point at empty wall.",
        "The wide-opening pointer is on the upper-right gold rim, away from the gatekeeper.",
        "The guard symbolizes lower resistance only. Exact numerical values, viscosity, length, pulsation, branching, and compliance are not depicted, so abstract clauses have no pointer.",
        "The arterial-lumen target is anatomical context only; it does not assert a measured radius change or resistance value."
      ]
    }
  ]
