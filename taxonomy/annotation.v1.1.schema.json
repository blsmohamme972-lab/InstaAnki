    "review_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "missing_concept_proposals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "concept_ids": {
      "type": "array",
      "items": {
        "enum": [
          "concept.coronary_dominance",
          "concept.vascular_resistance",
          "concept.poiseuille_law"
        ]
      },
      "uniqueItems": true,
      "maxItems": 3,
      "default": [],
      "description": "Optional tested non-disease concepts; absent is interpreted as an empty list."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "validated"
          }
        }
      },
      "then": {
        "properties": {
          "primary_specialty_id": {
            "type": "string"
          },
          "primary_domain_id": {
            "type": "string"
          },
          "focus_id": {
            "type": "string"
          },
          "review_reason": {
            "type": "null"
          },
          "missing_concept_proposals": {
            "maxItems": 0
          }
        }
      }
    }
  ]
