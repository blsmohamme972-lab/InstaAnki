  "scenes": [
    {
      "id": "scene-01",
      "start": 0.0,
      "end": 9.965291666666667,
      "duration": 9.965291666666667,
      "voiceStart": 0.18,
      "voiceEnd": 9.735291666666667,
      "startSample": 0,
      "endSample": 239167,
      "voiceStartSample": 4320,
      "voiceEndSample": 233647,
      "text": "At the double doors of the vascular gallery, imagine four number locks above the frame. Widening the doorway changes resistance through a fourth-power relationship.",
      "spokenText": "At the double doors of the vascular gallery, imagine four number locks above the frame. Widening the doorway changes resistance through a fourth-power relationship."
    },
    {
      "id": "scene-02",
      "start": 9.965291666666667,
      "end": 19.865291666666668,
      "duration": 9.9,
      "voiceStart": 9.965291666666667,
      "voiceEnd": 19.635291666666667,
      "startSample": 239167,
      "endSample": 476767,
      "voiceStartSample": 239167,
      "voiceEndSample": 471247,
      "text": "For steady laminar flow in the ideal tube model, resistance is proportional to viscosity and length, and inversely proportional to the fourth power of radius.",
      "spokenText": "For steady laminar flow in the ideal tube model, resistance is proportional to viscosity and length, and inversely proportional to the fourth power of radius."
    },
    {
      "id": "scene-03",
      "start": 19.865291666666668,
      "end": 28.655291666666667,
      "duration": 8.79,
      "voiceStart": 19.865291666666668,
      "voiceEnd": 28.425291666666666,
      "startSample": 476767,
      "endSample": 687727,
      "voiceStartSample": 476767,
      "voiceEndSample": 682207,
      "text": "If diameter doubles, radius doubles too. Raise that factor of two to the fourth power: two times two times two times two equals sixteen.",
      "spokenText": "If diameter doubles, radius doubles too. Raise that factor of two to the fourth power: two times two times two times two equals sixteen."
    },
    {
      "id": "scene-04",
      "start": 28.655291666666667,
      "end": 39.69925,
      "duration": 11.043958333333334,
      "voiceStart": 28.655291666666667,
      "voiceEnd": 39.46925,
      "startSample": 687727,
      "endSample": 952782,
      "voiceStartSample": 687727,
      "voiceEndSample": 947262,
      "text": "Resistance therefore becomes one sixteenth of its original value when length and viscosity stay unchanged. Starting from sixteen resistance units, the new value is one unit.",
      "spokenText": "Resistance therefore becomes one sixteenth of its original value when length and viscosity stay unchanged. Starting from sixteen resistance units, the new value is one unit."
    },
    {
      "id": "scene-05",
      "start": 39.69925,
      "end": 51.80920833333333,
      "duration": 12.109958333333333,
      "voiceStart": 39.69925,
      "voiceEnd": 51.579208333333334,
      "startSample": 952782,
      "endSample": 1243421,
      "voiceStartSample": 952782,
      "voiceEndSample": 1237901,
      "text": "This is an idealized laminar-flow relationship. In real circulation, pulsation, branching, and vessel compliance affect how pressure and flow behave. Keep the model assumptions in mind.",
      "spokenText": "This is an idealized laminar-flow relationship. In real circulation, pulsation, branching, and vessel compliance affect how pressure and flow behave. Keep the model assumptions in mind."
    },
    {
      "id": "scene-06",
      "start": 51.80920833333333,
      "end": 62.9685,
      "duration": 11.159291666666666,
      "voiceStart": 51.80920833333333,
      "voiceEnd": 62.6185,
      "startSample": 1243421,
      "endSample": 1511244,
      "voiceStartSample": 1243421,
      "voiceEndSample": 1502844,
      "text": "Return to the double doors and the four locks. Remember: double diameter, divide resistance by sixteen. The answer to this example is one peripheral resistance unit.",
      "spokenText": "Return to the double doors and the four locks. Remember: double diameter, divide resistance by sixteen. The answer to this example is one peripheral resistance unit."
    }
  ],
