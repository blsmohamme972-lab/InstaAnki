          "procedure.pneumonectomy",
          "procedure.esophagectomy",
          "procedure.pleural_decortication",
          "procedure.chest_drainage",
          "procedure.evar",
          "procedure.tevar",
          "procedure.carotid_endarterectomy",
          "procedure.peripheral_arterial_bypass",
          "procedure.dialysis_av_fistula"
