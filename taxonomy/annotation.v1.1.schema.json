    "condition_ids": {
      "type": "array",
      "items": {
        "enum": [
          "condition.coronary_artery_disease",
          "condition.aortic_stenosis",
          "condition.aortic_regurgitation",
          "condition.mitral_stenosis",
          "condition.mitral_regurgitation",
          "condition.infective_endocarditis",
          "condition.atrial_septal_defect",
          "condition.ventricular_septal_defect",
