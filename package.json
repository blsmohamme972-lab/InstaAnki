{
  "name": "instaanki",
  "version": "0.1.0",
  "private": true,
  "description": "Personal offline Android medical mnemonic learning with FSRS",
  "type": "commonjs",
  "scripts": {
    "build:web": "node tools/build_web.mjs",
    "test": "node --test tests/learning.test.cjs",
    "test:browser": "node tests/browser-smoke.cjs",
    "build:pack": "python tools/build_pack.py",
    "build:apk": "python android/build_apk.py --include-private"
  },
  "dependencies": {
    "ts-fsrs": "6.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.51.1"
  }
}
