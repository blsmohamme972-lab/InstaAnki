              "condition.thymoma",
              "condition.esophageal_cancer",
              "condition.achalasia",
              "condition.peripheral_arterial_disease",
              "condition.chronic_limb_threatening_ischemia",
              "condition.acute_limb_ischemia",
              "condition.carotid_stenosis",
              "condition.deep_vein_thrombosis",
              "condition.chronic_venous_insufficiency",
              "condition.lymphedema",
              "condition.aortic_aneurysm",
