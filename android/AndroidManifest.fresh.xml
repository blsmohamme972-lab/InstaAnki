<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.instaanki.fresh"
    android:versionCode="6"
    android:versionName="0.3.2">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:label="InstaAnki Fresh"
        android:icon="@drawable/app_icon"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:supportsRtl="false">
        <provider
            android:name="com.instaanki.app.FeedbackProvider"
            android:authorities="com.instaanki.fresh.feedback"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity
            android:name="com.instaanki.app.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
