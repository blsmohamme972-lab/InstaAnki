{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blsmohamme972-lab/InstaAnki/schema/pack.schema.json",
  "title": "InstaAnki pack manifest (pack.json)",
  "type": "object",
  "required": ["format", "formatVersion", "id", "version", "title", "language", "createdAt", "reels"],
  "properties": {
    "format": { "const": "instaanki-pack" },
    "formatVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 2000 },
    "language": { "$ref": "#/$defs/language" },
    "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "author": { "type": "string", "maxLength": 120 },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tag" }
    },
    "reels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "licenses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["files", "license"],
        "properties": {
          "files": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "source": { "type": "string" },
          "attribution": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "patternProperties": { "^x-": {} },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "tag": { "type": "string", "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$" },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" }
  }
}
